{
  "as_of": "2026-09-12",
  "prepared_by": "platform_normalization subtask",
  "purpose": "Primary-source annual EPS normalization and capital/lease screen for root 5-year scenarios; financial scenario assumptions are judgment, not forecasts.",
  "currency": "USD",
  "money_unit_unless_named": "USD billion",
  "ttm_convention": "Income and cash flows = FY2025 - H1 2025 + H1 2026. Historical diluted share estimate = FY average - half H1 2025 average + half H1 2026 average; rounding/day-count differences immaterial. Scenario denominators separately identified.",
  "scenario_formula": "EPS5 = normalized EPS0 * (1+ordinary EPS growth)^5 * (1+incremental AI terminal uplift); terminal stock value = EPS5 * terminal PE; add five annual dividends without reinvestment; CAGR = ((terminal stock value+dividends)/price)^(1/5)-1.",
  "scenario_guardrails": [
    "Ordinary growth includes ongoing deployed AI in existing business. Incremental AI factor is a bounded additional terminal level change, never a second five-year growth rate.",
    "Future SBC remains an expense; ordinary EPS CAGR is net of dilution/funding effects. No additional buyback return is added.",
    "Normalized tax rates are explicit analyst assumptions; use sensitivity, not false accounting precision.",
    "Cash screen subtracts SBC once from CFO-based cash; never deduct again from EPS.",
    "No investment holdings NAV is added to PE valuation; investment gains stripped. Ordinary net interest is retained, so arbitrary net-cash addition would double count.",
    "All four remain conditional on recovery of sustainable capital returns. Present liquidity cash is not maintenance owner cash; no credible terminal owner-cash derivation disclosed."
  ],
